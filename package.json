{
  "name": "@alex.radulescu/styled-static",
  "version": "1.0.0",
  "private": false,
  "description": "Near-zero-runtime styled components for React 19+ with Vite. CSS extracted at build time, minimal runtime.",
  "keywords": [
    "css-in-js",
    "react",
    "static-css",
    "styled-components",
    "vite",
    "zero-runtime"
  ],
  "license": "MIT",
  "author": "Alex Radulescu",
  "repository": {
    "type": "git",
    "url": "https://github.com/alexradulescu/styled-static"
  },
  "workspaces": [
    "docs",
    "benchmarks/*"
  ],
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js",
      "require": "./dist/vite.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js",
      "require": "./dist/runtime/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf ./dist",
    "build": "bun run clean && tsc -p tsconfig.build.json",
    "dev": "vite",
    "dev:watch": "tsc --watch",
    "test": "bun test --coverage --only-failures src/vite.test.ts src/index.test.ts src/build.test.ts showcase/contract.test.tsx",
    "test:watch": "bun test --watch",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "magic-string": "^0.30.21"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.10.6",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "acorn": "^8.17.0",
    "oxfmt": "^0.42.0",
    "oxlint": "^1.74.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^6.0.3",
    "vite": "^8.1.5"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "vite": "^8.0.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
